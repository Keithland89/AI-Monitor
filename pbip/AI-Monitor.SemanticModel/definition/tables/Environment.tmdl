/// Power Platform environments - the security and data boundary each agent lives in.
/// From arg_environments. Group, created and modified fields are not in that table, so they are blank.
table Environment
	lineageTag: d51d62b9-699c-4bed-b0d7-bd3f718ddea2

	column EnvironmentId
		dataType: string
		isHidden
		lineageTag: dbe5d9ed-0756-4beb-8db6-90bb3f5c4779
		summarizeBy: none
		sourceColumn: EnvironmentId

	column EnvironmentName
		dataType: string
		lineageTag: b73507d1-3065-4080-8fe0-60ac77ed05d9
		summarizeBy: none
		sourceColumn: EnvironmentName

	column Region
		dataType: string
		lineageTag: 4d65a56b-08f4-4b67-beaa-845462679201
		summarizeBy: none
		sourceColumn: Region

	column EnvironmentType
		dataType: string
		lineageTag: a93d1f3b-492a-4f76-8eb1-9bfa9b95d770
		summarizeBy: none
		sourceColumn: EnvironmentType

	column IsManaged
		dataType: boolean
		lineageTag: b0e4b7ae-e438-47d7-9ef9-76e6c4f3af15
		summarizeBy: none
		sourceColumn: IsManaged

	column EnvironmentGroupId
		dataType: string
		isHidden
		lineageTag: a7cc92d0-f9e1-497e-aed2-2ba70fbeac53
		summarizeBy: none
		sourceColumn: EnvironmentGroupId

	column CreatedAt
		dataType: dateTime
		formatString: yyyy-mm-dd hh:nn:ss
		lineageTag: 2d3beb09-f09f-4f46-b0a8-4e69fec9dc9b
		summarizeBy: none
		sourceColumn: CreatedAt

	column LastModifiedAt
		dataType: dateTime
		formatString: yyyy-mm-dd hh:nn:ss
		lineageTag: 1ca7e2b4-c791-40fe-9716-77a880b7c4d1
		summarizeBy: none
		sourceColumn: LastModifiedAt

	column CreatedBy
		dataType: string
		isHidden
		lineageTag: 9d77bf40-a1eb-4bb0-ba37-71b80390ec1e
		summarizeBy: none
		sourceColumn: CreatedBy

	column AdoptionBand = VAR agents = COUNTROWS ( RELATEDTABLE ( 'Agent' ) ) VAR active = COUNTROWS ( FILTER ( RELATEDTABLE ( 'Agent' ), 'Agent'[ActivityStatus] IN { "Active (7d)", "Active (30d)" } ) ) VAR rate = DIVIDE ( active, agents ) RETURN SWITCH ( TRUE (), ISBLANK ( agents ), "No agents", rate = 0, "No adoption", rate < 0.05, "Under 5%", rate < 0.1, "5-10%", rate < 0.25, "10-25%", "25% and above" )
		dataType: string
		lineageTag: 8f64ff42-c1ff-4f37-a113-e72d4cbce48a
		summarizeBy: none

	partition Environment = m
		mode: import
		source =
				let
				    Envs = FnDistinctKey(Table.SelectColumns(arg_environments, {"EnvironmentId", "EnvironmentName", "Region", "EnvironmentType", "IsManaged"}), "EnvironmentId"),
				    // Analytics Hub's arg_environments has no group, creation or modification fields: the columns stay, blank.
				    WithGroup = Table.AddColumn(Envs, "EnvironmentGroupId", each null, type nullable text),
				    WithCreated = Table.AddColumn(WithGroup, "CreatedAt", each null, type nullable datetime),
				    WithModified = Table.AddColumn(WithCreated, "LastModifiedAt", each null, type nullable datetime),
				    WithCreator = Table.AddColumn(WithModified, "CreatedBy", each null, type nullable text),
				    Final = Table.TransformColumnTypes(WithCreator, {{"EnvironmentId", type text}, {"EnvironmentName", type text}, {"Region", type text}, {"EnvironmentType", type text}, {"IsManaged", type logical}, {"EnvironmentGroupId", type text}, {"CreatedAt", type datetime}, {"LastModifiedAt", type datetime}, {"CreatedBy", type text}})
				in
				    Final
