/// Every individual governance risk factor that fired for an agent, with the points it contributed. Use this to explain a risk score.
table RiskDetail
	lineageTag: f287ece0-5203-4901-b3b8-22ca1d740935

	column AgentKey
		dataType: string
		isHidden
		lineageTag: 439e64bf-cbc8-497f-9958-743c6848761b
		summarizeBy: none
		sourceColumn: AgentKey

	column AgentName
		dataType: string
		lineageTag: 902c6166-29da-42a8-a64b-76dabc962797
		summarizeBy: none
		sourceColumn: AgentName

	column EnvironmentName
		dataType: string
		lineageTag: 9514e8b3-8bbd-483a-9126-eadac899d719
		summarizeBy: none
		sourceColumn: EnvironmentName

	column Platform
		dataType: string
		lineageTag: 2d6064f9-4e03-4b1d-b11b-1be65c6b477e
		summarizeBy: none
		sourceColumn: Platform

	/// The individual governance condition that fired.
	column RiskFactor
		dataType: string
		lineageTag: 2edc71eb-7b52-4931-94e6-df9b9eaa9ef7
		summarizeBy: none
		sourceColumn: RiskFactor

	/// Points this factor contributed to the agent's total risk score.
	column Points
		dataType: int64
		formatString: #,0
		lineageTag: 13bd1121-0e1c-4656-b368-58dd29222da4
		summarizeBy: sum
		sourceColumn: Points

	column RiskScore
		dataType: int64
		formatString: #,0
		lineageTag: 5623cf9e-5f1d-491d-b8a0-6f192e085c32
		summarizeBy: sum
		sourceColumn: RiskScore

	column RiskBand
		dataType: string
		lineageTag: e451e27f-6305-4b53-99d5-d630a7d49a5e
		summarizeBy: none
		sourceColumn: RiskBand

	partition RiskDetail = m
		mode: import
		source =
				let
				    Src = Table.SelectColumns(Agent, {"AgentKey", "AgentName", "EnvironmentName", "Platform", "Authentication",
				                                      "IsQuarantined", "SharedTenantWide", "WebSearchEnabled", "ConnectorCount",
				                                      "ConnectedAgentCount", "LastUsed", "HasUsageSignal"}, MissingField.UseNull),
				    Factors = Table.AddColumn(Src, "f", each
				        let
				            // Matches PowerShell's -in semantics exactly: Azure Resource Graph omits
				            // null-valued fields, and neither -in nor List.Contains matches a null,
				            // so an absent authentication property deliberately does not fire.
				            noAuth  = List.Contains({"None", "No authentication", ""}, [Authentication]),
				            quar    = FnToLogical([IsQuarantined]) = true,
				            tenant  = FnToLogical([SharedTenantWide]) = true,
				            // Only judged where the platform records use and a last-used source is loaded (Agent[HasUsageSignal]).
				            unused  = [LastUsed] = null and [HasUsageSignal] = true,
				            web     = FnToLogical([WebSearchEnabled]) = true,
				            conn    = [ConnectorCount] <> null and [ConnectorCount] > 0,
				            linked  = [ConnectedAgentCount] <> null and [ConnectedAgentCount] > 0
				        in
				            List.Combine({
				                if noAuth then {[RiskFactor = "No authentication configured", Points = 3]} else {},
				                if quar   then {[RiskFactor = "Agent is quarantined", Points = 3]} else {},
				                if tenant then {[RiskFactor = "Shared with the entire tenant", Points = 2]} else {},
				                if tenant and unused then {[RiskFactor = "Shared tenant-wide and never used", Points = 1]} else {},
				                if web    then {[RiskFactor = "Web search enabled on knowledge", Points = 1]} else {},
				                if conn   then {[RiskFactor = "Uses one or more connectors", Points = 1]} else {},
				                if linked then {[RiskFactor = "Connected to other agents", Points = 1]} else {}})),
				    Scored = Table.AddColumn(Factors, "RiskScore", each
				        let s = List.Sum(List.Transform([f], each _[Points])) in if s = null then 0 else s, Int64.Type),
				    Banded = Table.AddColumn(Scored, "RiskBand", each if [RiskScore] >= 5 then "High" else if [RiskScore] >= 3 then "Medium" else "Low", type text),
				    Fired  = Table.SelectRows(Banded, each List.Count([f]) > 0),
				    Expand = Table.ExpandListColumn(Fired, "f"),
				    Flat   = Table.ExpandRecordColumn(Expand, "f", {"RiskFactor", "Points"}, {"RiskFactor", "Points"}),
				    Kept   = Table.SelectColumns(Flat, {"AgentKey", "AgentName", "EnvironmentName", "Platform", "RiskFactor", "Points", "RiskScore", "RiskBand"}, MissingField.UseNull),
				    Typed  = Table.TransformColumnTypes(Kept, {{"AgentKey", type text}, {"AgentName", type text}, {"EnvironmentName", type text},
				                                              {"Platform", type text}, {"RiskFactor", type text}, {"Points", Int64.Type}})
				in
				    Typed

