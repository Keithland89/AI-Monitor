/// One row per agent per knowledge source type - what each agent is actually grounded in. This is the only integration surface Agent Builder agents have: they carry no Power Platform connectors, tools or flows, so they are invisible in the connector fact table.
/// From arg_agent_detail (knowledge by type) and arg_agent_config (web search).
/// In this CSV build those are arg_agent_detail.csv and arg_agent_config.csv.
table AgentKnowledge
	lineageTag: fb1a1d34-195d-46a9-8d95-97b8021dca41

	column AgentKey
		dataType: string
		isHidden
		lineageTag: b106e797-393c-44e3-a7b7-1d65ae5fdab7
		summarizeBy: none
		sourceColumn: AgentKey

	/// Friendly name of the knowledge source type, e.g. SharePoint sites, Public websites, Graph connectors.
	column KnowledgeType
		dataType: string
		lineageTag: e63a9d46-db08-455f-b9fe-08d36e04564c
		summarizeBy: none
		sourceColumn: KnowledgeType

	/// How many sources of this type the agent has configured.
	column SourceCount
		dataType: int64
		formatString: #,0
		lineageTag: f6b7c53d-86a2-4924-b88c-904630ac83c6
		summarizeBy: sum
		sourceColumn: SourceCount

	partition AgentKnowledge = m
		mode: import
		source =
				let
				    Labels = [files = "Uploaded files", fileGroups = "File groups", publicSites = "Public websites", sharepointSites = "SharePoint sites", dataverseSources = "Dataverse tables", graphConnectors = "Microsoft Graph connectors", powerPlatformConnectors = "Power Platform connectors", bingCustomSearch = "Bing custom search", teamsMessages = "Teams messages"],
				    Agents = Table.SelectColumns(AgentContract, {"AgentKey", "KnowledgeByType", "WebSearchEnabled"}),
				    // KnowledgeByType comes from arg_agent_detail; web search comes from arg_agent_config, so it shows in every mode.
				    WithRows = Table.AddColumn(Agents, "k", each
				        List.Transform(List.Select(FnPairs([KnowledgeByType]), (p) => p[Value] <> null and p[Value] > 0), (p) => [KnowledgeType = Record.FieldOrDefault(Labels, p[Key], p[Key]), SourceCount = p[Value]])
				        & (if [WebSearchEnabled] = true then {[KnowledgeType = "Web search", SourceCount = 1]} else {})),
				    Expanded = Table.ExpandListColumn(Table.SelectColumns(WithRows, {"AgentKey", "k"}), "k"),
				    NonEmpty = Table.SelectRows(Expanded, each [k] <> null),
				    Flat = Table.ExpandRecordColumn(NonEmpty, "k", {"KnowledgeType", "SourceCount"}, {"KnowledgeType", "SourceCount"}),
				    Final = Table.TransformColumnTypes(Flat, {{"AgentKey", type text}, {"KnowledgeType", type text}, {"SourceCount", Int64.Type}})
				in
				    Final
