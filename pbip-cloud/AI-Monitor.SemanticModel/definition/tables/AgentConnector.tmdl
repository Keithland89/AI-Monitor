/// One row per agent-to-connector binding, including MCP server tools.
/// From arg_agent_config (connector list) and arg_agent_detail (operation counts and MCP flags).
table AgentConnector
	lineageTag: 437f5d45-d281-4ca3-b29e-2d9e6f3084d6

	column AgentKey
		dataType: string
		isHidden
		lineageTag: 208eb503-4a7b-4aff-8098-ae60644258e1
		summarizeBy: none
		sourceColumn: AgentKey

	column ConnectorId
		dataType: string
		lineageTag: 08c8c4f4-775d-4a73-b39c-49f991379071
		summarizeBy: none
		sourceColumn: ConnectorId

	column OperationCount
		dataType: int64
		formatString: #,0
		lineageTag: 99087bed-e37f-43cf-8df0-4d1484364419
		summarizeBy: sum
		sourceColumn: OperationCount

	/// TRUE when the connector operation list advertises an MCP server tool.
	column IsMcpServer
		dataType: boolean
		lineageTag: c5af5e5b-8d73-43d1-b23f-13fe884e8f9c
		summarizeBy: none
		sourceColumn: IsMcpServer

	partition AgentConnector = m
		mode: import
		source =
				let
				    Agents = Table.SelectColumns(AgentContract, {"AgentKey", "Connectors", "ConnectorOperations", "McpConnectors"}),
				    // Connectors is "id; id"; arg_agent_detail adds per-connector operation counts and MCP flags when present.
				    WithRows = Table.AddColumn(Agents, "c", each
				        let
				            ids = if [Connectors] = null then {} else List.Distinct(List.Select(List.Transform(Text.Split([Connectors], ";"), Text.Trim), each _ <> "")),
				            ops = FnPairs([ConnectorOperations]),
				            mcp = if [McpConnectors] = null then null else List.Select(List.Transform(Text.Split([McpConnectors], ";"), Text.Trim), each _ <> "")
				        in
				            List.Transform(ids, (id) => [
				                ConnectorId = id,
				                OperationCount = List.Sum(List.Transform(List.Select(ops, (p) => p[Key] = id), (p) => p[Value])),
				                IsMcpServer = if mcp = null then Text.Contains(Text.Lower(id), "mcp") else List.Contains(mcp, id)])),
				    Expanded = Table.ExpandListColumn(Table.SelectColumns(WithRows, {"AgentKey", "c"}), "c"),
				    NonEmpty = Table.SelectRows(Expanded, each [c] <> null),
				    Flat = Table.ExpandRecordColumn(NonEmpty, "c", {"ConnectorId", "OperationCount", "IsMcpServer"}, {"ConnectorId", "OperationCount", "IsMcpServer"}),
				    Final = Table.TransformColumnTypes(Flat, {{"AgentKey", type text}, {"ConnectorId", type text}, {"OperationCount", Int64.Type}, {"IsMcpServer", type logical}})
				in
				    Final

