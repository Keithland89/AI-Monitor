/// Shadow AI seen on Defender-managed endpoints, one row per tool per detection layer.
/// Three layers, deliberately kept separate because they answer different questions and have different
/// blind spots: Installed says a packaged app is present, Executed says it actually ran, Network says
/// the device reached an AI service at all. A tool absent from Installed but present in Network is the
/// normal shape for browser-based use.
/// From defender_ai_installed and the 30-day rows of defender_shadow_ai_daily, Analytics Hub's Defender tables.
/// Empty when Defender is unlicensed, has no onboarded devices, or refuses the refresh account - see FnHunt.
table ShadowAiSignal
	lineageTag: 6d50f6ef-c22c-427a-a8b2-4e06a72487be

	/// Installed, Executed or Network. See the table description for what each proves.
	column Layer
		dataType: string
		lineageTag: 0c0d3614-97f0-4fec-8550-f921e5f3bb9a
		sourceColumn: Layer

	column Category
		dataType: string
		lineageTag: 8bc9e6b8-0297-4afb-89a2-c5335b617351
		sourceColumn: Category

	column Vendor
		dataType: string
		lineageTag: 9df09a2d-0a7d-4c8b-9a81-f62b4fa1dbc2
		sourceColumn: Vendor

	column AppName
		dataType: string
		lineageTag: e9c2a2a8-242d-4b6b-ba73-9268b24a5f42
		sourceColumn: AppName

	/// Sanctioned or Unsanctioned, taken from ShadowAiWatchlist. This is local policy, not an API verdict.
	column Posture
		dataType: string
		lineageTag: 6b2b405e-35a2-4481-8f02-3c6793d1848b
		sourceColumn: Posture

	/// The raw string Defender returned - software name, process file name or URL - before it was mapped to a watchlist app.
	column Detected
		dataType: string
		lineageTag: fe772f45-59eb-4f11-ace6-a2409cd9f9dd
		sourceColumn: Detected

	column DeviceCount
		dataType: int64
		formatString: #,0
		lineageTag: 02b68884-0838-4e64-a55f-37bf17426512
		sourceColumn: DeviceCount

	column UserCount
		dataType: int64
		formatString: #,0
		lineageTag: f3c73d0c-11c1-47ff-82fd-c6f48c8c51b8
		sourceColumn: UserCount

	column LastSeen
		dataType: dateTime
		formatString: dd/mm/yyyy hh:nn:ss
		lineageTag: 1fc67095-8e4a-4ba9-aa51-a131c9fa634c
		sourceColumn: LastSeen

	partition ShadowAiSignal = m
		mode: import
		source =
				let
				    Watch = Table.RenameColumns(Table.SelectColumns(defender_ai_watchlist, {"Tool", "Category", "Vendor", "Posture", "ProcessNames", "Domains"}), {{"Tool", "WTool"}}),
				    Installed = Table.SelectRows(defender_ai_installed, each [Tool] <> null and [Tool] <> ""),
				    // Ran and Network come from the 30-day window rows of the latest day; LastSeen is the last daily row with events.
				    Daily = Table.SelectRows(defender_shadow_ai_daily, each [Tool] <> null and [Tool] <> "" and List.Contains({"Ran", "Network"}, [Layer])),
				    Month = Table.SelectRows(Daily, each [Window] = "30d"),
				    LatestDay = List.Max(Month[Day]),
				    MonthRows = Table.SelectRows(Month, each [Day] = LatestDay),
				    Seen = Table.Group(Table.SelectRows(Daily, each [Window] = "1d" and [Events] <> null and [Events] > 0), {"Layer", "Tool"}, {{"LastDay", each List.Max([Day]), type nullable date}}),
				    JoinSeen = Table.NestedJoin(MonthRows, {"Layer", "Tool"}, Seen, {"Layer", "Tool"}, "s", JoinKind.LeftOuter),
				    WithSeen = Table.ExpandTableColumn(JoinSeen, "s", {"LastDay"}, {"LastDay"}),
				    InstalledRecs = List.Transform(Table.ToRecords(Installed), (r) => [Layer = "Installed", Tool = r[Tool], Found = r[SoftwareNames], DeviceCount = r[Devices], UserCount = null, LastSeen = null]),
				    ActivityRecs = List.Transform(Table.ToRecords(WithSeen), (r) => [
				        Layer = if r[Layer] = "Ran" then "Executed" else r[Layer],
				        Tool = r[Tool],
				        Found = null,
				        DeviceCount = r[Devices],
				        UserCount = r[Users],
				        LastSeen = if r[LastDay] = null then null else DateTime.From(r[LastDay])]),
				    Rows = FnRecordsToTable(InstalledRecs & ActivityRecs, {"Layer", "Tool", "Found", "DeviceCount", "UserCount", "LastSeen"}),
				    JoinWatch = Table.NestedJoin(Rows, {"Tool"}, Watch, {"WTool"}, "w", JoinKind.LeftOuter),
				    WithWatch = Table.ExpandTableColumn(JoinWatch, "w", {"Category", "Vendor", "Posture", "ProcessNames", "Domains"}, {"WCategory", "WVendor", "WPosture", "WProcess", "WDomain"}),
				    Shaped = FnRecordsToTable(List.Transform(Table.ToRecords(WithWatch), (r) => [
				        Layer = r[Layer],
				        Category = if r[WCategory] = null or r[WCategory] = "" then "Unclassified" else r[WCategory],
				        Vendor = if r[WVendor] = null then "" else r[WVendor],
				        AppName = r[Tool],
				        Posture = if r[WPosture] = null or r[WPosture] = "" then "Unsanctioned" else r[WPosture],
				        Detected = if r[Layer] = "Installed" then r[Found] else if r[Layer] = "Executed" then r[WProcess] else r[WDomain],
				        DeviceCount = r[DeviceCount],
				        UserCount = r[UserCount],
				        LastSeen = r[LastSeen]]), {"Layer", "Category", "Vendor", "AppName", "Posture", "Detected", "DeviceCount", "UserCount", "LastSeen"}),
				    Typed = Table.TransformColumnTypes(Shaped, {{"Layer", type text}, {"Category", type text}, {"Vendor", type text}, {"AppName", type text}, {"Posture", type text}, {"Detected", type text}, {"DeviceCount", Int64.Type}, {"UserCount", Int64.Type}, {"LastSeen", type datetime}})
				in
				    Typed

