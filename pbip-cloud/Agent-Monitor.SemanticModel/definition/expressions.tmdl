/// One column of ShadowAiWatchlist as a quoted, comma-separated KQL term list. Blank entries are
/// dropped, so a tool with no process name contributes nothing to the process query.
expression FnWatchTerms =
		(column as text) as text =>
		let
		    Vals = List.Select(Table.Column(ShadowAiWatchlist, column), each _ <> null and Text.Trim(_) <> ""),
		    Quoted = List.Transform(List.Distinct(Vals), each "'" & Text.Lower(Text.Trim(_)) & "'")
		in
		    Text.Combine(Quoted, ", ")
	lineageTag: 3a91880b-816f-4dd6-a677-fd191b77cac2

	annotation PBI_ResultType = Function

/// The watchlist row whose term for `column` appears in `value`, or null. Longest term wins, so
/// "Claude Code" resolves to its own row rather than the shorter "claude" one regardless of row order.
expression FnWatchMatch =
		(value as nullable text, column as text) as nullable record =>
		let
		    V = Text.Lower(if value = null then "" else value),
		    Candidates = Table.SelectRows(ShadowAiWatchlist, each Text.Trim(Record.Field(_, column)) <> ""),
		    Ranked = Table.AddColumn(Candidates, "TermLen", each Text.Length(Record.Field(_, column)), Int64.Type),
		    Sorted = Table.Sort(Ranked, {{"TermLen", Order.Descending}}),
		    Hits = Table.SelectRows(Sorted, each Text.Contains(V, Text.Lower(Text.Trim(Record.Field(_, column))))),
		    First = if Table.IsEmpty(Hits) then null else Hits{0}
		in
		    First
	lineageTag: be68be2a-45cc-454d-9fa1-87eab6e4cd40

	annotation PBI_ResultType = Function

/// Runs one Microsoft Defender advanced hunting query and returns its rows.
/// Two deliberate choices here:
/// 1. The base URL is a literal and everything variable goes in RelativePath and Query. That keeps this
/// a STATIC data source, which is what lets scheduled refresh run in the service with no gateway.
/// Concatenating the KQL into the URL would make it dynamic and the service would refuse it.
/// To use a regional host - uk. eu. us. au. - edit the literal below; do not make it a parameter.
/// 2. A failure returns an empty table rather than propagating. Defender may be unlicensed, have no
/// onboarded devices, or refuse the account for want of AdvancedQuery.Read; none of that should stop
/// the other sixteen tables refreshing. Same contract as FnDataverseOptional.
expression FnHunt =
		(query as text, columns as list) as table =>
		let
		    Fetch = () =>
		        let
		            Raw = Web.Contents(
		                      "https://api.security.microsoft.com",
		                      [RelativePath = "api/advancedqueries", Query = [key = query], Timeout = #duration(0, 0, 4, 0)]),
		            Parsed = Json.Document(Raw),
		            Items = if Record.HasFields(Parsed, "Results") then Parsed[Results] else {},
		            Tbl = FnRecordsToTable(Items, columns)
		        in
		            Table.Buffer(Tbl),
		    Attempt = try FnRetry(Fetch, Text.Length(query))
		in
		    if Attempt[HasError] then #table(columns, {}) else Attempt[Value]
	lineageTag: 156771b8-ae21-42eb-82c6-cdb72c9040d3

	annotation PBI_ResultType = Function

/// A KQL prefix test per watched term - "SoftwareName startswith 'cursor' or ...".
/// Used instead of has_any for software inventory because has is token-based: "cursor" is a
/// token of "node-cli-cursor", so has_any reported an npm terminal-cursor package as the
/// Cursor editor. A prefix test cannot do that, and it keeps the precision on the server so
/// the top-N cap is spent on real hits rather than noise.
expression FnWatchPrefix =
		(column as text, field as text) as text =>
		let
		    Vals = List.Select(Table.Column(ShadowAiWatchlist, column), each _ <> null and Text.Trim(_) <> ""),
		    Tests = List.Transform(List.Distinct(Vals), each field & " startswith '" & Text.Lower(Text.Trim(_)) & "'")
		in
		    Text.Combine(Tests, " or ")
	lineageTag: 5f2c9a74-3e18-4d6b-9a11-7c4e0b2d8f36

	annotation PBI_ResultType = Function

/// The watchlist row for one software-inventory entry, or null if it is not a watched tool.
/// Deliberately stricter than FnWatchMatch: the name must START with the term. Contains-matching
/// mapped the npm packages "node-cli-cursor" and "restore-cursor" onto Cursor and reported a
/// build agent as running an unsanctioned AI editor. A vendor match is still accepted on its own,
/// so "Anysphere Cursor" is caught by its vendor even though the name does not lead with the term.
expression FnInstalledMatch =
		(name as nullable text, vendor as nullable text) as nullable record =>
		let
		    N = Text.Lower(if name = null then "" else Text.Trim(name)),
		    Candidates = Table.SelectRows(ShadowAiWatchlist, each Text.Trim([SoftwareMatch]) <> ""),
		    Ranked = Table.AddColumn(Candidates, "TermLen", each Text.Length([SoftwareMatch]), Int64.Type),
		    Sorted = Table.Sort(Ranked, {{"TermLen", Order.Descending}}),
		    ByName = Table.SelectRows(Sorted, each Text.StartsWith(N, Text.Lower(Text.Trim([SoftwareMatch])))),
		    ByVendor = FnWatchMatch(vendor, "VendorMatch")
		in
		    if not Table.IsEmpty(ByName) then ByName{0} else ByVendor
	lineageTag: 8d3b1c60-6a92-4f57-b8e3-15d9c7a4e2b0

	annotation PBI_ResultType = Function

/// Shapes a table to one Analytics Hub contract: exactly the listed columns, in order, with the listed types.
/// A column the source lacks comes back null, so an older store or an absent CSV still refreshes.
expression FnContract =
		(source as table, contract as list) as table =>
		let
		    Names = List.Transform(contract, each _{0}),
		    Kept = Table.SelectColumns(source, Names, MissingField.UseNull),
		    AsText = (v as any) as nullable text => if v = null then null else Text.From(v),
		    Rule = (c as list) as list =>
		        if c{1} = "date" then {c{0}, FnToDate, type nullable date}
		        else if c{1} = "datetime" then {c{0}, FnToDateTime, type nullable datetime}
		        else if c{1} = "bool" then {c{0}, FnToLogical, type nullable logical}
		        else if c{1} = "int" then {c{0}, FnToInt, Int64.Type}
		        else {c{0}, AsText, type nullable text},
		    Typed = Table.TransformColumns(Kept, List.Transform(contract, Rule))
		in
		    Typed
	lineageTag: 0a21f3bc-4968-4787-8632-1fb2fb820f51

	annotation PBI_ResultType = Function

/// The rows of an Analytics Hub snapshot table that belong to its latest SnapshotDate.
expression FnLatestSnapshot =
		(t as table) as table =>
		let
		    Latest = List.Max(Table.Column(t, "SnapshotDate")),
		    Rows = Table.SelectRows(t, each [SnapshotDate] = Latest)
		in
		    Rows
