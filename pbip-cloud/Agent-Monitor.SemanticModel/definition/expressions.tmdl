/// Every AI tool this solution looks for on Defender-managed devices. Single source of truth:
/// the hunting queries and the ShadowAiCatalog table are all generated from this one list, so
/// adding a tool means editing here and nowhere else.
/// Posture is the only judgement call in the table - sanctioned-or-not is local policy, not
/// something any API reports. Edit it to match your own approved-tooling list.
/// VendorMatch is blank for Microsoft, Google, GitHub and Hugging Face on purpose: matching those
/// vendor names against software inventory would return every Edge and Chrome install in the estate.
expression ShadowAiWatchlist =
		#table(
		    type table [Category = text, Vendor = text, AppName = text, Posture = text, SoftwareMatch = text, VendorMatch = text, ProcessName = text, Domain = text],
		    {
		        { "Assistant", "Anthropic", "Claude Code", "Unsanctioned", "claude code", "", "claude.exe", "" },
		        { "Assistant", "OpenAI", "ChatGPT", "Unsanctioned", "chatgpt", "openai", "chatgpt.exe", "chatgpt.com" },
		        { "Assistant", "Anthropic", "Claude", "Unsanctioned", "claude", "anthropic", "", "claude.ai" },
		        { "Assistant", "Google", "Gemini", "Unsanctioned", "", "", "", "gemini.google.com" },
		        { "Assistant", "Perplexity", "Perplexity", "Unsanctioned", "perplexity", "perplexity", "perplexity.exe", "perplexity.ai" },
		        { "Assistant", "xAI", "Grok", "Unsanctioned", "", "", "", "grok.com" },
		        { "Assistant", "DeepSeek", "DeepSeek", "Unsanctioned", "", "", "", "deepseek.com" },
		        { "Assistant", "Mistral AI", "Le Chat", "Unsanctioned", "", "", "", "chat.mistral.ai" },
		        { "Assistant", "Microsoft", "Microsoft Copilot", "Sanctioned", "microsoft copilot", "", "", "copilot.microsoft.com" },
		        { "Coding", "GitHub", "GitHub Copilot", "Sanctioned", "github copilot", "", "copilot.exe", "api.githubcopilot.com" },
		        { "Coding", "Anysphere", "Cursor", "Unsanctioned", "cursor", "anysphere", "cursor.exe", "cursor.com" },
		        { "Coding", "Codeium", "Windsurf", "Unsanctioned", "windsurf", "codeium", "windsurf.exe", "codeium.com" },
		        { "Coding", "Tabnine", "Tabnine", "Unsanctioned", "tabnine", "tabnine", "tabnine.exe", "tabnine.com" },
		        { "Local model", "Ollama", "Ollama", "Unsanctioned", "ollama", "ollama", "ollama.exe", "ollama.com" },
		        { "Local model", "LM Studio", "LM Studio", "Unsanctioned", "lm studio", "lm studio", "lm studio.exe", "lmstudio.ai" },
		        { "Local model", "Nomic AI", "GPT4All", "Unsanctioned", "gpt4all", "nomic", "gpt4all.exe", "gpt4all.io" },
		        { "Local model", "Msty", "Msty", "Unsanctioned", "msty", "msty", "msty.exe", "msty.app" },
		        { "Local model", "Mintplex Labs", "AnythingLLM", "Unsanctioned", "anythingllm", "mintplex", "anythingllm.exe", "anythingllm.com" },
		        { "API endpoint", "OpenAI", "OpenAI API", "Unsanctioned", "", "", "", "api.openai.com" },
		        { "API endpoint", "Anthropic", "Anthropic API", "Unsanctioned", "", "", "", "api.anthropic.com" },
		        { "API endpoint", "Google", "Gemini API", "Unsanctioned", "", "", "", "generativelanguage.googleapis.com" },
		        { "API endpoint", "Hugging Face", "Hugging Face", "Unsanctioned", "", "", "", "huggingface.co" }
		    })
