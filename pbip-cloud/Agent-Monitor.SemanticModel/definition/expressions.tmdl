/// Splits a contract list such as "files=2; publicSites=1" into [Key, Value] records. Value is a number or null.
expression FnPairs =
		(value as nullable text) as list =>
		let
		    Parts = if value = null then {} else List.Select(List.Transform(Text.Split(value, ";"), Text.Trim), each _ <> ""),
		    Pairs = List.Transform(Parts, each [
		        Key = Text.Trim(Text.BeforeDelimiter(_, "=", {0, RelativePosition.FromEnd})),
		        Value = try Number.From(Text.AfterDelimiter(_, "=", {0, RelativePosition.FromEnd})) otherwise null])
		in
		    Pairs
	lineageTag: 97ef0efd-9c6d-48cc-b27b-27306b97e15c

	annotation PBI_ResultType = Function

/// A KQL case() mapping `field` to the watchlist tool whose `column` term it matches, longest term first.
/// mode is exact, domain (host or any subdomain), prefix or contains. Mirrors Analytics Hub's hunting queries.
expression FnWatchCase =
		(column as text, field as text, mode as text) as text =>
		let
		    Quote = (s as text) as text => "'" & Text.Replace(Text.Replace(s, "\", "\\"), "'", "\'") & "'",
		    Rows = Table.SelectRows(ShadowAiWatchlist, each Record.Field(_, column) <> null and Text.Trim(Record.Field(_, column)) <> ""),
		    Terms = Table.AddColumn(Rows, "Term", each Text.Lower(Text.Trim(Record.Field(_, column))), type text),
		    Ranked = Table.AddColumn(Terms, "TermLen", each Text.Length([Term]), Int64.Type),
		    Sorted = Table.Sort(Ranked, {{"TermLen", Order.Descending}}),
		    Test = (t as text) as text =>
		        if mode = "exact" then field & " == " & Quote(t)
		        else if mode = "domain" then "(" & field & " == " & Quote(t) & " or " & field & " endswith " & Quote("." & t) & ")"
		        else if mode = "prefix" then field & " startswith " & Quote(t)
		        else field & " contains " & Quote(t),
		    Tests = List.Transform(Table.ToRecords(Sorted), (r) => Test(r[Term]) & ", " & Quote(r[AppName])),
		    Out = if List.IsEmpty(Tests) then "''" else "case(" & Text.Combine(Tests, ", ") & ", '')"
		in
		    Out
