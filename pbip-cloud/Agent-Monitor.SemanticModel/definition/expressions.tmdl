		    Rows = FnRecordsToTable(Raw, {"AgentResourceId", "ConnectorId", "OperationCount", "IsMcpServer", "Ops"}),
		    Trimmed = Table.SelectRows(Table.TransformColumns(Rows, {{"ConnectorId", each if _ = null then "" else Text.Trim(_), type text}}), each [ConnectorId] <> ""),
		    WithKnowledge = Table.AddColumn(Trimmed, "KnowledgeOps", each
		        let ops = try Json.Document([Ops]) otherwise null
		        in if ops is list then List.Count(List.Select(ops, (o) => o is record and Text.Lower(Text.From(Record.FieldOrDefault(o, "usedAs", ""))) = "knowledge")) else 0, Int64.Type),
		    Grouped = Table.Group(WithKnowledge, {"AgentResourceId", "ConnectorId"}, {
		        {"OperationCount", each List.Sum(List.Transform([OperationCount], FnToInt)), Int64.Type},
		        {"KnowledgeOps", each List.Sum([KnowledgeOps]), Int64.Type},
		        {"IsMcpServer", each List.AnyTrue(List.Transform([IsMcpServer], (m) => FnToLogical(m) = true)), type logical}})
		in
		    Grouped
