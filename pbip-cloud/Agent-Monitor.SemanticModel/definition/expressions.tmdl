/// Analytics Hub contract table defender_shadow_ai_daily: devices, users and events per tool per day (Window 1d)
/// and over 7 and 30 days, for the Ran (process) and Network layers.
expression defender_shadow_ai_daily =
		let
		    Contract = {{"Day", "date"}, {"Window", "text"}, {"Layer", "text"}, {"Tool", "text"}, {"Devices", "int"}, {"Users", "int"}, {"Events", "int"}, {"LoadedAt", "datetime"}},
		    Live = () =>
		        let
		            LoadedAt = DateTimeZone.RemoveZone(DateTimeZone.UtcNow()),
		            Stats = "Devices = dcount(DeviceId), Users = dcountif(User, isnotempty(User)), Events = sum(Events)",
		            // One query per layer: daily rows plus 7- and 30-day window rows, as Analytics Hub stores them.
		            Windowed = (src as text) as text =>
		                "let End = startofday(now()); let B = materialize(" & src & " | summarize Events = count() by Day = startofday(Timestamp), DeviceId, User, Tool);"
		                & " union (B | summarize " & Stats & " by Day, Tool | extend Window = '1d'),"
		                & " (B | where Day >= End - 7d | summarize " & Stats & " by Tool | extend Day = End - 1d, Window = '7d'),"
		                & " (B | summarize " & Stats & " by Tool | extend Day = End - 1d, Window = '30d')"
		                & " | project Day, Window, Tool, Devices, Users, Events",
		            RanSource = "DeviceProcessEvents | where Timestamp > ago(30d) | where FileName in~ (" & FnWatchTerms("ProcessName") & ")"
		                & " | extend Term = tolower(FileName) | extend Tool = " & FnWatchCase("ProcessName", "Term", "exact")
		                & " | where isnotempty(Tool) | extend User = tostring(AccountUpn)",
		            NetworkSource = "DeviceNetworkEvents | where Timestamp > ago(30d) | where isnotempty(RemoteUrl) | where RemoteUrl has_any (" & FnWatchTerms("Domain") & ")"
		                & " | extend Host = tolower(tostring(split(replace_regex(RemoteUrl, @'^[a-zA-Z]+://', ''), '/')[0]))"
		                & " | extend Host = trim_end(@'\.', tostring(split(Host, ':')[0])) | extend Tool = " & FnWatchCase("Domain", "Host", "domain")
		                & " | where isnotempty(Tool) | extend User = tostring(InitiatingProcessAccountUpn)",
		            Cols = {"Day", "Window", "Tool", "Devices", "Users", "Events"},
		            Ran = Table.AddColumn(FnHunt(Windowed(RanSource), Cols), "Layer", each "Ran", type text),
		            Network = Table.AddColumn(FnHunt(Windowed(NetworkSource), Cols), "Layer", each "Network", type text),
		            Both = Table.Combine({Ran, Network}),
		            Days = Table.TransformColumns(Both, {{"Day", each let d = FnToDateTime(_) in if d = null then null else DateTime.Date(d), type nullable date}}),
		            Out = Table.AddColumn(Days, "LoadedAt", each LoadedAt, type datetime)
		        in
		            Out,
		    Raw =
		        if SourceMode = "AnalyticsHub" then Sql.Database(SqlServer, SqlDatabase){[Schema = "dbo", Item = "defender_shadow_ai_daily"]}[Data]
		        else Live(),
		    Shaped = FnContract(Raw, Contract)
		in
		    Shaped
	lineageTag: 6fb537b1-b654-41f2-b3b7-c9c559e2722c

	annotation PBI_ResultType = Table

/// Analytics Hub contract table defender_ai_installed: devices with each watched tool installed (software inventory).
expression defender_ai_installed =
		let
		    Contract = {{"SnapshotDate", "date"}, {"Tool", "text"}, {"Devices", "int"}, {"SoftwareNames", "text"}, {"LoadedAt", "datetime"}},
		    Live = () =>
		        let
		            Today = DateTime.Date(DateTimeZone.RemoveZone(DateTimeZone.UtcNow())),
		            LoadedAt = DateTimeZone.RemoveZone(DateTimeZone.UtcNow()),
		            // Software names are matched on a PREFIX (see FnWatchPrefix), vendors on a contains, longest term first.
		            Kql = "DeviceTvmSoftwareInventory | extend Name = tolower(SoftwareName), Vend = tolower(SoftwareVendor)"
		                & " | where (" & FnWatchPrefix("SoftwareMatch", "Name") & ") or Vend has_any (" & FnWatchTerms("VendorMatch") & ")"
		                & " | extend Tool = " & FnWatchCase("SoftwareMatch", "Name", "prefix")
		                & " | extend Tool = iff(isempty(Tool), " & FnWatchCase("VendorMatch", "Vend", "contains") & ", Tool)"
		                & " | where isnotempty(Tool) | summarize Devices = dcount(DeviceId), SoftwareNames = make_set(SoftwareName, 10) by Tool"
		                & " | project Tool, Devices, SoftwareNames = strcat_array(SoftwareNames, '; ')",
		            Rows = FnHunt(Kql, {"Tool", "Devices", "SoftwareNames"}),
		            WithSnapshot = Table.AddColumn(Rows, "SnapshotDate", each Today, type date),
		            Out = Table.AddColumn(WithSnapshot, "LoadedAt", each LoadedAt, type datetime)
		        in
		            Out,
		    Raw =
		        if SourceMode = "AnalyticsHub" then FnLatestSnapshot(Sql.Database(SqlServer, SqlDatabase){[Schema = "dbo", Item = "defender_ai_installed"]}[Data])
		        else Live(),
		    Shaped = FnContract(Raw, Contract)
		in
		    Shaped
	lineageTag: ab5ce792-3d97-420e-bf02-6f15b161c36e

	annotation PBI_ResultType = Table

/// Agent-Monitor's own per-device Shadow AI drill-down. Live only: Analytics Hub stores aggregates, so
/// AnalyticsHub mode returns an empty table with this schema.
expression defender_shadow_ai_device =
		let
		    Contract = {{"Layer", "text"}, {"DeviceName", "text"}, {"AppName", "text"}, {"Posture", "text"}, {"Detected", "text"}, {"Detail", "text"}, {"UserUpn", "text"}, {"LastSeen", "datetime"}},
		    // Analytics Hub stores Shadow AI aggregates only, so the per-device drill-down is Live-only.
		    Live = () =>
		        let
		            KqlInstalled = "DeviceTvmSoftwareInventory"
		                & " | where (" & FnWatchPrefix("SoftwareMatch", "SoftwareName") & ")"
		                & " or SoftwareVendor has_any (" & FnWatchTerms("VendorMatch") & ")"
		                & " | project DeviceName, Detected = SoftwareName, Vendor = SoftwareVendor, Detail = SoftwareVersion"
		                & " | take 5000",
		            Installed = FnHunt(KqlInstalled, {"DeviceName", "Detected", "Vendor", "Detail"}),
		            InstalledKept = List.Select(Table.ToRecords(Installed), each FnInstalledMatch([Detected], [Vendor]) <> null),
		            InstalledRecs = List.Transform(InstalledKept, (r) =>
		                       let
		                           W = FnInstalledMatch(r[Detected], r[Vendor])
		                       in
		                           [ Layer = "Installed",
		                             DeviceName = r[DeviceName],
		                             AppName = W[AppName],
		                             Posture = W[Posture],
		                             Detected = r[Detected],
		                             Detail = r[Detail],
		                             UserUpn = null,
		                             LastSeen = null ]),
		            KqlRun = "DeviceProcessEvents"
		                & " | where Timestamp > ago(30d)"
		                & " | where FileName in~ (" & FnWatchTerms("ProcessName") & ")"
		                & " | summarize LastSeen = max(Timestamp), Runs = count() by DeviceName, FileName, AccountUpn"
		                & " | top 5000 by LastSeen desc",
		            Run = FnHunt(KqlRun, {"DeviceName", "FileName", "AccountUpn", "LastSeen", "Runs"}),
		            RunRecs = List.Transform(Table.ToRecords(Run), (r) =>
		                       let
		                           W = FnWatchMatch(r[FileName], "ProcessName")
		                       in
		                           [ Layer = "Executed",
		                             DeviceName = r[DeviceName],
		                             AppName = if W = null then r[FileName] else W[AppName],
		                             Posture = if W = null then "Unsanctioned" else W[Posture],
		                             Detected = r[FileName],
		                             Detail = if r[Runs] = null then "" else Text.From(r[Runs]) & " runs",
		                             UserUpn = r[AccountUpn],
		                             LastSeen = FnToDateTime(r[LastSeen]) ]),
		            Cols = {"Layer", "DeviceName", "AppName", "Posture", "Detected", "Detail", "UserUpn", "LastSeen"},
		            Out = Table.Combine({FnRecordsToTable(InstalledRecs, Cols), FnRecordsToTable(RunRecs, Cols)})
		        in
		            Out,
		    Raw =
		        if SourceMode = "AnalyticsHub" then #table(List.Transform(Contract, each _{0}), {})
		        else Live(),
		    Shaped = FnContract(Raw, Contract)
		in
		    Shaped
	lineageTag: 2a0ccd94-5b3f-4fe3-87fc-a8ad80caa263

	annotation PBI_ResultType = Table

/// One row per Copilot Studio and Agent Builder agent: arg_agent_config joined to Agent-Monitor's arg_agent_detail on
/// AgentResourceId. Without a detail row, AgentId falls back to BotId and the detail columns are null.
expression AgentContract =
		let
		    Config = Table.RemoveColumns(arg_agent_config, {"SnapshotDate"}),
		    Detail = Table.RenameColumns(Table.RemoveColumns(arg_agent_detail, {"SnapshotDate"}), {{"AgentId", "DetailAgentId"}, {"Region", "DetailRegion"}}),
		    DetailCols = List.RemoveItems(Table.ColumnNames(Detail), {"AgentResourceId"}),
		    Joined = Table.NestedJoin(Config, {"AgentResourceId"}, Detail, {"AgentResourceId"}, "d", JoinKind.LeftOuter),
		    Expanded = Table.ExpandTableColumn(Joined, "d", DetailCols, DetailCols),
		    WithAgentId = Table.AddColumn(Expanded, "AgentId", each if [DetailAgentId] <> null and [DetailAgentId] <> "" then [DetailAgentId] else [BotId], type text),
		    WithKey = Table.AddColumn(WithAgentId, "AgentKey", each (if [EnvironmentId] = null then "" else [EnvironmentId]) & "|" & (if [AgentId] = null then "" else [AgentId]), type text)
		in
		    WithKey
	lineageTag: 993f055a-785a-4af5-b5b1-50b80fb12a0d

	annotation PBI_ResultType = Table
