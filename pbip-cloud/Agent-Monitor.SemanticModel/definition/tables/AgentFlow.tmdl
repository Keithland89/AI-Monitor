/// Agent flows registered in the tenant, from the Analytics Hub contract table arg_agent_flows.
/// State and last used are not in that table, so they are blank.
table AgentFlow
	lineageTag: 7251e05a-b333-4795-b820-91dbe2104f4c

	column FlowId
		dataType: string
		isHidden
		lineageTag: bd78731c-53b1-4661-ac73-2bf134ae3947
		summarizeBy: none
		sourceColumn: FlowId

	column FlowName
		dataType: string
		lineageTag: 7eb79940-4ec8-419b-87e2-924ab2aee8ef
		summarizeBy: none
		sourceColumn: FlowName

	column FlowType
		dataType: string
		lineageTag: 7f1ecc23-caab-4590-aff9-efba9fd50ce6
		summarizeBy: none
		sourceColumn: FlowType

	column EnvironmentId
		dataType: string
		isHidden
		lineageTag: cba497df-ef6d-4066-9596-8ca841cf7dee
		summarizeBy: none
		sourceColumn: EnvironmentId

	column State
		dataType: string
		lineageTag: e774b533-6bfc-44d3-b7c9-40c2d5fcc521
		summarizeBy: none
		sourceColumn: State

	column CreatedAt
		dataType: dateTime
		formatString: yyyy-mm-dd hh:nn:ss
		lineageTag: eab6165e-c31f-4572-88ab-770d4c2acc37
		summarizeBy: none
		sourceColumn: CreatedAt

	column Region
		dataType: string
		lineageTag: 55099952-d4d4-4482-a5ed-95761a8fc560
		summarizeBy: none
		sourceColumn: Region

	column LastUsed
		dataType: dateTime
		formatString: yyyy-mm-dd hh:nn:ss
		lineageTag: 4c0da362-a646-4539-a496-afa33e5945bd
		summarizeBy: none
		sourceColumn: LastUsed

	partition AgentFlow = m
		mode: import
		source =
				let
				    Flows = Table.SelectColumns(arg_agent_flows, {"FlowId", "FlowName", "EnvironmentId", "CreatedAt"}),
				    Envs = Table.RenameColumns(Table.SelectColumns(arg_environments, {"EnvironmentId", "Region"}), {{"EnvironmentId", "EnvKey"}}),
				    Joined = Table.NestedJoin(Flows, {"EnvironmentId"}, Envs, {"EnvKey"}, "e", JoinKind.LeftOuter),
				    Expanded = Table.ExpandTableColumn(Joined, "e", {"Region"}, {"Region"}),
				    // arg_agent_flows carries agent flows only, with no state or last-used fields.
				    WithType = Table.AddColumn(Expanded, "FlowType", each "Agent Flow", type text),
				    WithState = Table.AddColumn(WithType, "State", each null, type nullable text),
				    WithUse = Table.AddColumn(WithState, "LastUsed", each null, type nullable datetime),
				    Kept = Table.SelectColumns(WithUse, {"FlowId", "FlowName", "FlowType", "EnvironmentId", "State", "CreatedAt", "Region", "LastUsed"}),
				    Converted = Table.TransformColumns(Kept, {{"CreatedAt", FnToDateTime, type datetime}}),
				    Final = Table.TransformColumnTypes(Converted, {{"FlowId", type text}, {"FlowName", type text}, {"FlowType", type text}, {"EnvironmentId", type text}, {"State", type text}, {"Region", type text}, {"LastUsed", type datetime}})
				in
				    Final

